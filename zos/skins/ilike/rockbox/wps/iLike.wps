# NOTE(S)                                                                                                            #
#                                                                                                                    #
######################################################################################################################
#
#
#
#
#
#
#
#
#
#
#       NOTE: "TIME IN TITLE"
#
# The original Apple iPod Nano firmware has a setting
# to show the time in the Status Bar.
# Enabled by default, to disable uncomment line 231 and comment:
#
# line 232
#
#
#
#       NOTE: ABSOLUTE VOLUME DISPLAY
#
# Although not included in the original Apple iPod Nano firmware
# some users have expressed a desire for an absolute volume
# display in decibels.
# Disabled by default, to enable comment line 241 and uncomment:
#
# line 239 <-- Always visible
# or
# line 240 <-- Only on volume change
#
#
#
#
#
#
#
#
#
#
######################################################################################################################
#                                                                                                                    #
# WPS CODE BEGINS                                                                                                    #
#                                                                                                                    #
######################################################################################################################
#
#
#
#       STATUS BAR [DISABLED]
#
%wd
#
#
#
#       BACKDROP
#
%X(Backdrop.bmp)
#
#
#
#	PRELOAD ADDITIONAL FONT(S)
#
%Fl(2,18 iLike.fnt)
#
#
#
#       PRELOAD IMAGES
#
%xl(A,AA Bottom.bmp,6,110)
%xl(B,AA Left.bmp,6,50)
%xl(C,AA Right.bmp,68,50)
%xl(D,Battery Icon.bmp,0,0,25)
%xl(E,Disk Access.bmp,0,0,6)
%xl(F,Hold Icon.bmp,0,0)
%xl(G,Playmode Icon.bmp,0,0,4)
%xl(H,Repeat Icon.bmp,0,0,4)
%xl(I,Shuffle Icon.bmp,0,0)
%xl(J,Volume Left.bmp,4,131)
%xl(K,Volume Right.bmp,193,131)
#
#
#
#       ALBUM ART/INFO HANDLING
#
%?C<%Vd(a)%xd(A)%xd(B)%xd(C)|%Vd(b)>
#
#
#
#       DISK ACCESS AND PLAYMODE HANDLING
#
%?lh<%Vd(c)|%Vd(e)>
#
#
#
#       VOLUME BAR AND PROGRESS BAR HANDLING
#
%?mv(2.0)<%Vd(f)%xd(J)%xd(K)|%Vd(d)>
#
#
#       ALBUM ART
#
%ax%Vl(a,8,50,60,60,-)%Vf(000000)%Vb(FFFFFF)
%Cl(0,0,60,60,c,c)
%Cd
#
#
#
#       ALBUM INFO [WITH ALBUM ART]
#
%ax%Vl(a,74,48,144,18,2)%Vf(000000)%Vb(FFFFFF)
%s%al%?pE(10)<%Sx(Next Track:)|%?it<%it|%fn>>
#
%ax%Vl(a,74,72,144,18,2)%Vf(000000)%Vb(FFFFFF)
%s%al%?pE(10)<%?It<%It|%Fn>|%?ia<%ia|%?d(3)<%d(2)|%?Sr<kbps%fb %fc|%fc %fbkbps>>>>
#
%ax%Vl(a,74,96,144,18,2)%Vf(000000)%Vb(FFFFFF)
%s%al%?pE(10)<%?Ia<%Ia|%?D(3)<%D(2)|%?Sr<kbps%Fb %Fc|%Fc %Fbkbps>>>|%?id<%id|%?d(3)<%d(3)|%?Sr<kHz%fk|%fkkHz>>>>
#
#
#
#     ALBUM INFO [WITHOUT ALBUM ART]
#
%Vl(b,1,48,218,18,2)%Vf(000000)%Vb(FFFFFF)
%s%ac%?pE(10)<%Sx(Next Track:)|%?it<%it|%fn>>
#
%Vl(b,1,72,218,18,2)%Vf(000000)%Vb(FFFFFF)
%s%ac%?pE(10)<%?It<%It|%Fn>|%?ia<%ia|%?d(3)<%d(2)|%?Sr<kbps%fb %fc|%fc %fbkbps>>>>
#
%Vl(b,1,96,218,18,2)%Vf(000000)%Vb(FFFFFF)
%s%ac%?pE(10)<%?Ia<%Ia|%?D(3)<%D(2)|%?Sr<kbps%Fb %Fc|%Fc %Fbkbps>>>|%?id<%id|%?d(3)<%d(3)|%?Sr<kHz%fk|%fkkHz>>>>
#
#
#
#       BATTERY ICON AND CHARGE ANIMATION
#
%V(190,4,25,12,-)%Vf(000000)%Vb(FFFFFF)
%?bp<%?bc<%t(1.0)%xd(Da);%t(1.0)%xd(Db)|%xd(Dc)>|%?bl<%xd(Dd)|%xd(Dd)|%xd(De)|%xd(Df)|%xd(Dg)|%xd(Dh)|%xd(Di)|%xd(Dj)|%xd(Dk)|%xd(Dl)|%xd(Dm)|%xd(Dn)|%xd(Do)|%xd(Dp)|%xd(Dq)|%xd(Dr)|%xd(Ds)|%xd(Dt)|%xd(Du)|%xd(Dv)|%xd(Dw)|%xd(Dx)|%xd(Dy)>>
#
#
#
#       DISK ACCESS ANIMATION
#
%Vl(c,3,2,16,16,-)%Vf(000000)%Vb(FFFFFF)
%t(0.1)%xd(Ea);%t(0.1)%xd(Eb);%t(0.1)%xd(Ec);%t(0.1)%xd(Ed);%t(0.1)%xd(Ee);%t(0.1)%xd(Ef)
#
#
#
#       HOLD ICON
#
%V(24,4,11,13,-)%Vf(000000)%Vb(FFFFFF)
%?mh<%xd(F)|%?mr<%xd(F)>>
#
#
#
#       PROGRESS BAR
#
%Vl(d,12,134,196,10,-)%Vf(000000)%Vb(FFFFFF)
%pb(0,0,196,10,Progress Bar.bmp)
#
#
#
#       PLAYLIST POSITION
#
%ax%V(11,26,124,18,2)%Vf(000000)%Vb(FFFFFF)
%s%al%?Sr<%pe %Sx(of) %pp|%pp %Sx(of) %pe>
#
#
#
#       PLAYMODE ICON[S]
#
%Vl(e,4,5,13,11,-)%Vf(000000)%Vb(FFFFFF)
%?mp<|%xd(Ga)|%xd(Gb)|%xd(Gc)|%xd(Gd)||||>
#
#
#
#       REPEAT ICON[S]
#
%ax%V(177,28,16,14,-)%Vf(000000)%Vb(FFFFFF)
%?mm<|%xd(Ha)|%xd(Hb)|%t(1.0)%xd(Hc);%t(1.0)%xd(Ha)|%xd(Hd)>
#
#
#
#       SHUFFLE ICON
#
%ax%V(193,28,16,14,-)%Vf(000000)%Vb(FFFFFF)
%?ps<%xd(I)>
#
#
#
#       STATUS/TITLE BAR ["NOW PLAYING" & 12/24 HOUR CLOCK]
#
%V(40,2,140,18,2)%Vf(000000)%Vb(FFFFFF)
#%s%ac%?bp<%?bc<Charging|Charged>|%Sx(Now Playing)>
%s%ac%t(10.0)%?bp<%?bc<Charging|Charged>|%Sx(Now Playing)>;%s%ac%t(10.0)%?cf<%cH:%cM|%cl:%cM %cP>
#
#
#
#       TIME ELAPSED/REMAINING
#
%V(11,150,198,18,2)%Vf(000000)%Vb(FFFFFF)
#%?mv(2.0)<%ac%pvdB|%al%pc%ac%pvdB%ar-%pr>
#%?mv(2.0)<%ac%pvdB|%al%pc%ar-%pr>
%?mv(2.0)<|%al%pc%ar-%pr>
#
#
#
#       VOLUME BAR
#
%Vl(f,27,134,166,10,-)%Vf(000000)%Vb(FFFFFF)
%pv(0,0,166,10,Volume Bar.bmp)
#
#
#
#
#
#
#
#
#
#
