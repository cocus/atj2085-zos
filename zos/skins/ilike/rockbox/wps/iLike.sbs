# NOTE(S)                                                                                                            #
#                                                                                                                    #
######################################################################################################################
#
#
#
#
#
#
#
#
#
#
#       NOTE: "TIME IN TITLE"
#
# The original Apple iPod Nano firmware has a setting
# to show the time in the Status Bar.
# Enabled by default, to disable uncomment line 138 and comment:
#
# line 139
#
#
#
#
#
#
#
#
#
#
######################################################################################################################
#                                                                                                                    #
# SBS CODE BEGINS                                                                                                    #
#                                                                                                                    #
######################################################################################################################
#
#
#
#       STATUS BAR [DISABLED]
#
%wd
#
#
#
#       TITLE BAR [DISABLED]
#
%?Lt<>
#
#
#
#	PRELOAD ADDITIONAL FONT(S)
#
%Fl(2,18 iLike.fnt)
#
#
#
#       PRELOAD IMAGES
#
%xl(A,Battery Icon.bmp,0,0,25)
%xl(B,Disk Access.bmp,0,0,6)
%xl(C,Hold Icon.bmp,0,0)
%xl(D,Playmode Icon.bmp,0,0,4)
#
#
#
#       DISK ACCESS/PLAYMODE HANDLING
#
%?lh<%Vd(a)|%Vd(b)>
#
#
#
#       BATTERY ICON AND CHARGE ANIMATION
#
%V(190,4,25,12,-)%Vf(000000)%Vb(FFFFFF)
%?bp<%?bc<%t(1.0)%xd(Aa);%t(1.0)%xd(Ab)|%xd(Ac)>|%?bl<%xd(Ad)|%xd(Ad)|%xd(Ae)|%xd(Af)|%xd(Ag)|%xd(Ah)|%xd(Ai)|%xd(Aj)|%xd(Ak)|%xd(Al)|%xd(Am)|%xd(An)|%xd(Ao)|%xd(Ap)|%xd(Aq)|%xd(Ar)|%xd(As)|%xd(At)|%xd(Au)|%xd(Av)|%xd(Aw)|%xd(Ax)|%xd(Ay)>>
#
#
#
#       DISK ACCESS ANIMATION
#
%Vl(a,3,2,16,16,-)%Vf(000000)%Vb(FFFFFF)
%t(0.1)%xd(Ba);%t(0.1)%xd(Bb);%t(0.1)%xd(Bc);%t(0.1)%xd(Bd);%t(0.1)%xd(Be);%t(0.1)%xd(Bf)
#
#
#
#       HOLD ICON
#
%V(24,4,11,13,-)%Vf(000000)%Vb(FFFFFF)
%?mh<%xd(C)|%?mr<%xd(C)>>
#
#
#
#       PLAYMODE ICON[S]
#
%Vl(b,4,5,13,11,-)%Vf(000000)%Vb(FFFFFF)
%?mp<|%xd(Da)|%xd(Db)|%xd(Dc)|%xd(Dd)|%?Rp<%xd(Da)>|%?Rp<%xd(Db)>|%?tp<%xd(Da)>|%?tp<%xd(Db)>>
#
#
#
#       STATUS/TITLE BAR ["NOW PLAYING" & 12/24 HOUR CLOCK]
#
%V(40,2,140,18,2)%Vf(000000)%Vb(FFFFFF)
#%s%ac%t(10.0)%?bp<%?bc<Charging|Charged>|%?cs<iPod||%?Rp<%Sx(Recording)>|%?tp<%Sx(FM Radio)>|%Sx(Playlist)>>
%s%ac%t(10.0)%?bp<%?bc<Charging|Charged>|%?cs<iPod||%?Rp<%Sx(Recording)>|%?tp<%Sx(FM Radio)>|%Sx(Playlist)>>;%t(10.0)%ac%?cf<%cH:%cM|%cl:%cM %cP>
#
#
#
#      UI VIEWPORT
#
%Vi(-,0,22,220,154,1)%Vf(000000)%Vb(FFFFFF)
#
#
#
#
#
#
#
#
#
#
