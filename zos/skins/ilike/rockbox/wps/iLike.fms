# NOTE(S)                                                                                                            #
#                                                                                                                    #
######################################################################################################################
#
#
#
#
#
#
#
#
#
#
#       NOTE: "TIME IN TITLE"
#
# The original Apple iPod Nano firmware has a setting
# to show the time in the Status Bar.
# Enabled by default, to disable uncomment line 211 and comment:
#
# line 210
#
#
#
#       NOTE: ABSOLUTE VOLUME DISPLAY
#
# Although not included in the original Apple iPod Nano firmware
# some users have expressed a desire for an absolute volume
# display in decibels.
# Disabled by default, to enable comment line 234 and uncomment:
#
# line 232 <-- Always visible
# or
# line 233 <-- Only on volume change
#
#
#
#
#
#
#
#
#
#
######################################################################################################################
#                                                                                                                    #
# FMS CODE BEGINS                                                                                                    #
#                                                                                                                    #
######################################################################################################################
#
#
#
#       STATUS BAR [DISABLED]
#
%wd
#
#
#
#       BACKDROP
#
%X(Backdrop.bmp)
#
#
#
#	PRELOAD ADDITIONAL FONT(S)
#
%Fl(2,18 iLike.fnt)
#
#
#
#       PRELOAD IMAGES
#
%xl(A,AA Bottom.bmp,6,110)
%xl(B,AA Left.bmp,6,50)
%xl(C,AA Right.bmp,68,50)
%xl(D,Battery Icon.bmp,0,0,25)
%xl(E,Disk Access.bmp,0,0,6)
%xl(F,Hold Icon.bmp,0,0)
%xl(G,Playmode Icon.bmp,0,0,4)
%xl(H,Stereo Icon.bmp,0,0)
%xl(I,Volume Left.bmp,4,131)
%xl(J,Volume Right.bmp,193,131)
#
#
#
#       DISK ACCESS HANDLING
#
%?lh<%Vd(a)|%Vd(b)>
#
#
#
#       RADIO ART/INFO HANDLING
#
%?C<%Vd(c)%xd(A)%xd(B)%xd(C)|%Vd(d)>
#
#
#
#       VOLUME BAR AND TUNER BAR HANDLING
#
%?mv(2.0)<%Vd(f)%xd(I)%xd(J)|%Vd(e)>
#
#
#
#       BATTERY ICON AND CHARGE ANIMATION
#
%V(190,4,25,12,-)%Vf(000000)%Vb(FFFFFF)
%?bp<%?bc<%t(1.0)%xd(Da);%t(1.0)%xd(Db)|%xd(Dc)>|%?bl<%xd(Dd)|%xd(Dd)|%xd(De)|%xd(Df)|%xd(Dg)|%xd(Dh)|%xd(Di)|%xd(Dj)|%xd(Dk)|%xd(Dl)|%xd(Dm)|%xd(Dn)|%xd(Do)|%xd(Dp)|%xd(Dq)|%xd(Dr)|%xd(Ds)|%xd(Dt)|%xd(Du)|%xd(Dv)|%xd(Dw)|%xd(Dx)|%xd(Dy)>>
#
#
#
#       DISK ACCESS ANIMATION
#
%Vl(a,3,2,16,16,-)%Vf(000000)%Vb(FFFFFF)
%t(0.1)%xd(Ea);%t(0.1)%xd(Eb);%t(0.1)%xd(Ec);%t(0.1)%xd(Ed);%t(0.1)%xd(Ee);%t(0.1)%xd(Ef)
#
#
#
#       HOLD ICON
#
%V(24,4,11,13,-)%Vf(000000)%Vb(FFFFFF)
%?mh<%xd(F)|%?mr<%xd(F)>>
#
#
#
#       PLAYMODE ICON[S]
#
%Vl(b,4,5,13,11,-)%Vf(000000)%Vb(FFFFFF)
%?mp<|||||||%xd(Ga)|%xd(Gb)>
#
#
#
#       PRESET POSITION
#
%ax%V(11,26,124,18,2)%Vf(000000)%Vb(FFFFFF)
%s%al%?tm<%Sx(Scan)|%?Sr<%Tc %Sx(of) %Ti %Sx(Preset)|%Sx(Preset) %Ti %Sx(of) %Tc>>
#
#
#
#       RADIO ART
#
%ax%Vl(c,8,50,60,60,-)%Vf(000000)%Vb(FFFFFF)
%Cl(0,0,60,60,c,c)
%Cd
#
#
#
#       RADIO INFO [WITH RADIO ART]
#
%ax%Vl(c,74,48,144,18,2)%Vf(000000)%Vb(FFFFFF)
%al%tfMhz
#
%ax%Vl(c,74,72,144,18,2)%Vf(000000)%Vb(FFFFFF)
%s%al%?tx<%ty|%Tn>
#
%ax%Vl(a,74,96,144,18,2)%Vf(000000)%Vb(FFFFFF)
%s%al%?tx<%tz|%?ts<%Sx(Stereo)|%Sx(Mono)>>
#
#
#
#       RADIO INFO [WITHOUT RADIO ART]
#
%Vl(d,1,48,218,18,2)%Vf(000000)%Vb(FFFFFF)
%ac%tfMhz
#
%Vl(d,1,72,218,18,2)%Vf(000000)%Vb(FFFFFF)
%s%ac%?tx<%ty|%Tn>
#
%Vl(d,1,96,218,18,2)%Vf(000000)%Vb(FFFFFF)
%s%ac%?tx<%tz|%?ts<%Sx(Stereo)|%Sx(Mono)>>
#
#
#
#       STATUS/TITLE BAR ["FM RADIO" & 12/24 HOUR CLOCK]
#
%V(40,2,140,18,2)%Vf(000000)%Vb(FFFFFF)
#%s%ac%Sx(FM Radio)
%t(10.0)%s%ac%Sx(FM Radio);%t(10.0)%ac%?cf<%cH:%cM|%cl:%cM %cP>
#
#
#
#       STEREO ICON
#
%ax%V(193,28,16,14,-)%Vf(000000)%Vb(FFFFFF)
%?ts<%xd(H)>
#
#
#
#       TUNER BAR
#
%Vl(e,12,134,196,10,-)%Vf(000000)%Vb(FFFFFF)
%pb(0,0,196,10,Progress Bar.bmp)
#
#
#
#       TUNER MINIMUM/MAXIMUM FREQUENCIES
#
%V(11,150,198,18,2)%Vf(000000)%Vb(FFFFFF)
#%?mv(2.0)<%ac%pvdB|%al%ta%ac%pvdB%ar%tb>
#%?mv(2.0)<%ac%pvdB|%al%ta%ar%tb>
%?mv(2.0)<|%al%ta%ar%tb>
#
#
#
#       VOLUME BAR
#
%Vl(f,27,134,166,10,-)%Vf(000000)%Vb(FFFFFF)
%pv(0,0,166,10,Volume Bar.bmp)
#
#
#
#
#
#
#
#
#
#
